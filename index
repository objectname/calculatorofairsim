<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Batch Flight Route & Intercept Analyzer</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
        .control-panel { padding: 15px; background: #2c3e50; color: white; display: flex; gap: 15px; flex-wrap: wrap; align-items: center; }
        .control-panel label { display: flex; flex-direction: column; font-size: 14px; }
        .control-panel input { margin-top: 5px; }
        button { padding: 8px 15px; background: #e74c3c; color: white; border: none; cursor: pointer; font-weight: bold; border-radius: 4px; }
        button:hover { background: #c0392b; }
        #map { height: 65vh; width: 100%; }
        #results-container { height: 20vh; overflow-y: auto; background: #ecf0f1; padding: 10px; font-family: monospace; font-size: 13px; }
        table { width: 100%; border-collapse: collapse; background: white; }
        th, td { border: 1px solid #bdc3c7; padding: 6px; text-align: left; color: #333; }
        th { background: #34495e; color: white; }
    </style>
</head>
<body>
    <div class="control-panel">
        <label>File 1 (Routes A - Cyan Color): 
            <input type="file" id="file1" accept=".csv, .xlsx, .txt">
        </label>
        <label>File 2 (Routes B - Magenta Color): 
            <input type="file" id="file2" accept=".csv, .xlsx, .txt">
        </label>
        <button onclick="processUploadedFiles()">Plot & Find Intercepts</button>
    </div>

    <div id="map"></div>
    <div id="results-container">
        <b>Intercept Results Log:</b>
        <table id="results-table">
            <thead>
                <tr>
                    <th>Route A (File 1)</th>
                    <th>Route B (File 2)</th>
                    <th>Intercept Lat</th>
                    <th>Intercept Lon</th>
                </tr>
            </thead>
            <tbody id="results-body">
                <tr><td colspan="4">Upload files and click 'Plot & Find Intercepts' to run analysis.</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- SheetJS for Excel/CSV Parsing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="main.js"></script>
</body>
</html>
